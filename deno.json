{
	"name": "@marianmeres/trend-chart",
	"version": "0.4.0",
	"exports": "./src/mod.ts",
	"compilerOptions": {
		"lib": [
			"dom",
			"dom.iterable",
			"deno.ns"
		]
	},
	"publish": {
		"exclude": [
			"example",
			"tmp"
		]
	},
	"lint": {
		"exclude": [
			"example/dist"
		]
	},
	"tasks": {
		"test": "deno test",
		"test:watch": "deno test --watch",
		"example:build": "deno run -A jsr:@marianmeres/deno-build --root example/src --outdir example/dist",
		"example:watch": "deno run -A jsr:@marianmeres/deno-build --root example/src --outdir example/dist --watch --watch-dir src",
		"example:themes": "deno run -A example/themes/_generate.ts",
		"example:serve": "deno run -A jsr:@std/http@^1/file-server example",
		"npm:build": "deno run -A scripts/build-npm.ts",
		"npm:publish": "deno run -A scripts/build-npm.ts && cd ./.npm-dist && npm publish --access=public",
		"release": "deno run -A jsr:@marianmeres/release",
		"publish": "deno publish && deno task npm:publish",
		"rp": "deno task release -y && deno task publish",
		"rpm": "deno task release minor -y && deno task publish"
	},
	"imports": {
		"@marianmeres/npmbuild": "jsr:@marianmeres/npmbuild@^1.16.0",
		"@std/assert": "jsr:@std/assert@^1.0.19",
		"@std/fs": "jsr:@std/fs@^1.0.24",
		"@std/path": "jsr:@std/path@^1.1.6"
	},
	"fmt": {
		"exclude": [
			"example/index.html",
			"example/dist",
			"example/reboot.css",
			"example/themes/*.css"
		],
		"useTabs": true,
		"lineWidth": 90,
		"indentWidth": 4,
		"proseWrap": "preserve"
	}
}
